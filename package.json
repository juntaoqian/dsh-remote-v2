{
  "name": "dsh-remote-v2",
  "version": "0.1.0",
  "description": "DSH Remote v2 — isolated, stable remote access for DeepSeek Harness (sidecar gateway + Quick/Named Cloudflare Tunnel + one-time pairing)",
  "type": "module",
  "license": "MIT",
  "icon": "./icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "core/",
    "icon.svg",
    "cordis.patch.yml",
    "NOTICE",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.2"
  },
  "scripts": {
    "test": "node --test",
    "smoke": "node scripts/smoke.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "remote-access",
    "cloudflared",
    "quick-tunnel",
    "pairing"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
